# =====================================================================================================
# AGRO AI backend configuration.  Copy to `.env` for local development (`cp .env.example .env`).
# `.env` is git-ignored: NEVER commit real secrets. In production set these in the host's dashboard
# (Render ▸ Environment), not in a file.   Every variable the app reads is listed here.
# =====================================================================================================

# ---------- Core ----------
ENVIRONMENT=development            # development | test | production   (production turns on strict safety checks)
# Signs login tokens. Dev: leave empty (an insecure dev default is used). PRODUCTION: REQUIRED, >= 32 random chars:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
BCRYPT_ROUNDS=12                   # password hashing cost (leave at 12)

# ---------- Database ----------
# Dev:   sqlite:///./agroai.db
# Prod:  your hosted PostgreSQL URL. Render/Heroku style "postgres://..." is accepted and converted automatically.
#        (Render Free has NO persistent disk, so SQLite is refused in production.)
DATABASE_URL=sqlite:///./agroai.db

# ---------- URLs and CORS ----------
FRONTEND_URL=http://localhost:5173 # where the React app is served (used for Google sign-in redirects)
BACKEND_URL=http://localhost:8000  # this API's public URL (used to build the Google redirect URI)
# Comma-separated EXACT origins allowed to call the API with cookies. Never "*". No trailing slash.
# Production example: https://your-site.netlify.app
CORS_ORIGINS=http://localhost:5173
# Optional regex for Netlify deploy previews, e.g.  https://deploy-preview-\d+--your-site\.netlify\.app
CORS_ORIGIN_REGEX=

# ---------- Sessions / cookies ----------
ACCESS_TOKEN_MINUTES=15            # short-lived access token (kept in browser memory only)
REFRESH_TOKEN_DAYS=14              # rotating refresh token in an HttpOnly cookie
COOKIE_SECURE=false                # PRODUCTION must be true (HTTPS only)
# lax = frontend and API on the SAME site (dev, or a Netlify proxy / same parent domain).
# none = frontend and API on DIFFERENT sites (e.g. *.netlify.app -> *.onrender.com); requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
MAX_FAILED_LOGINS=5                # account lockout after this many wrong passwords
LOCKOUT_MINUTES=15

# ---------- Email verification (OTP) ----------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_BACKEND=console              # console = print codes to the server log (dev only) | smtp = send via SMTP | brevo = Brevo HTTPS API (use on Render Free: SMTP ports are blocked)
EXPOSE_DEV_OTP=false               # true returns the code in the API response for local testing. Ignored in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BREVO_API_KEY=                     # backend-only secret, needed when EMAIL_BACKEND=brevo (sender in EMAIL_FROM must be verified in Brevo)
BREVO_BASE_URL=https://api.brevo.com
EMAIL_FROM=AGRO AI <no-reply@example.com>

# ---------- Google sign-in (optional) ----------
# Google Cloud > APIs & Services > Credentials > OAuth client ID > "Web application":
#   Authorized JavaScript origins : http://localhost:5173   and   https://agroai-app.netlify.app
#   Authorized redirect URIs      : http://localhost:8000/api/v1/auth/google/callback
#                                   https://agroai-api-sjl9.onrender.com/api/v1/auth/google/callback
# The redirect URI is built as BACKEND_URL + /api/v1/auth/google/callback (there is no separate GOOGLE_REDIRECT_URI variable), so it must match
# BACKEND_URL exactly: scheme, host, port and path. The client SECRET stays on the server only (backend/.env locally, Render env in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- First administrator (created on startup if both are set) ----------
ADMIN_EMAIL=
ADMIN_NAME=AGRO AI Admin
ADMIN_PASSWORD=                    # >= 8 chars with a letter and a number. No default; well-known passwords are refused in production.

# ---------- AI guidance provider (Gemini) ----------
# The key lives ONLY here (server environment). It is never stored in the database, returned by any API,
# written to logs, or shown in the admin console. Create one at https://aistudio.google.com/apikey
# Two keys are used alternately (request 1 -> key 1, 2 -> key 2, ...) with automatic failover to the other key. The counter lives in the database
# (table `counters`, one atomic statement), so it survives restarts and concurrent requests. One key alone also works. GEMINI_API_KEY is the old
# single-key name and is still read as key 1 when GEMINI_API_KEY_1 is empty.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash      # verify at https://ai.google.dev/gemini-api/docs/models
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---------- Specialist plant / disease providers (all optional, backend-only secrets) ----------
# Used BEFORE Gemini, chosen by our model's confidence (README "Analysis flow"). A provider without a key, or one that fails, is skipped; Gemini always gets the original image.
PLANTNET_API_KEY=                  # plant identification, https://my.plantnet.org
PLANTNET_BASE_URL=https://my-api.plantnet.org
PLANTIX_API_KEY=                   # crop disease analysis (Plantix partner API; response format only partly verified)
PLANTIX_BASE_URL=https://api.plantix.net
KINDWISE_API_KEY=                  # crop.health (crop disease identification)
KINDWISE_CROP_BASE_URL=https://crop.kindwise.com
KINDWISE_PLANT_API_KEY=            # optional: plant.health (non-crop plants), a separate Kindwise product/key
KINDWISE_PLANT_BASE_URL=https://plant.id
SPECIALIST_TIMEOUT_SECONDS=20
ROUTE_CONFIDENCE_THRESHOLD=0.80    # our model's confidence: <= starts with Kindwise, > starts with Pl@ntNet
 first
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1                   # extra attempts on timeouts / 5xx only (never on rate limits)
AI_MAX_CONCURRENCY=3               # simultaneous provider calls
AI_MAX_IMAGE_SIDE=1568             # longest image side sent to the provider (metadata is stripped)
AI_USER_HOURLY_LIMIT=30            # guidance requests per user per hour

# ---------- Our ML model (inference only) ----------
ML_MODEL_DIR=                      # default: backend/app/ml (agro_model.onnx + model_meta.json)
ML_THREADS=1                       # ONNX Runtime CPU threads (keep 1 on a small free instance)
ML_MAX_CONCURRENCY=2               # simultaneous inferences (bounds RAM)
ML_MAX_PIXELS=40000000             # images with more pixels are refused (decompression-bomb guard)

# ---------- Uploads ----------
UPLOAD_DIR=./uploads               # NOTE: Render Free's disk is ephemeral; uploaded images are lost on restart (see README)
MAX_UPLOAD_MB=10                   # hard cap; the admin console can only lower it
