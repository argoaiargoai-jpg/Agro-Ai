# AGRO AI frontend (Vite). Only variables starting with VITE_ are exposed to the browser: NEVER put a secret here.
# Local development: leave everything empty. The dev server proxies /api to http://localhost:8000.

# Production (set in Netlify ▸ Site settings ▸ Environment variables, then redeploy):
# Public URL of the API, https only, no trailing slash, WITHOUT /api/v1.   Example:
# VITE_API_URL=https://agroai-api.onrender.com
VITE_API_URL=

# Dev-server only (not used in production builds): where `npm run dev` proxies /api
# VITE_BACKEND_URL=http://localhost:8000
